# Copy to .env (repo root). All integrations are optional; the app runs in demo mode without them.

# --- Core ---------------------------------------------------------------
# Required when DEMO_MODE=false or DATABASE_URL is set (32+ chars):  openssl rand -base64 48
# Left empty in demo mode, a random key is generated once in the data directory.
JWT_SECRET=
DEMO_MODE=true                      # false in production: disables one-click demo accounts and /docs
DOCTOR_INVITE_CODE=MEDTRUST-STAFF   # required for doctor/student self-registration
DATABASE_PATH=backend/data/medtrust.db
CORS_ORIGINS=http://localhost:5173,http://localhost:8000,*
HOSPITAL_NAME=MedTrust University Teaching Hospital

# --- Scale-out (optional; install backend/requirements-scale.txt) ---------
DATABASE_URL=                        # postgresql://user:pass@host:5432/medtrust (default: SQLite at DATABASE_PATH)
DB_POOL_SIZE=10
REDIS_URL=                           # redis://host:6379/0  shared rooms + rate limits across instances
WORKERS=1                            # uvicorn workers for run_app.sh (>1 requires REDIS_URL)
FORWARDED_ALLOW_IPS=127.0.0.1        # proxies trusted for X-Forwarded-For

# --- Limits ----------------------------------------------------------------
AI_CONCURRENCY=2                     # simultaneous Gemini calls per process
MAX_BODY_BYTES=1000000
WS_MAX_MESSAGE_BYTES=64000

# --- Gemini (AI case sheet + multilingual summaries) --------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Google Meet REST + Calendar (optional external meeting link + transcript import)
# OAuth client + refresh token for a Workspace account. Scopes:
#   https://www.googleapis.com/auth/calendar.events
#   https://www.googleapis.com/auth/meetings.space.created
#   https://www.googleapis.com/auth/meetings.space.readonly
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary

# --- Firebase Authentication (optional Google sign-in) -------------------
FIREBASE_PROJECT_ID=
# Frontend build-time values (frontend/.env or exported before `npm run build`)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# --- WebRTC ICE (TURN strongly recommended across hospital networks) -----
STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=
