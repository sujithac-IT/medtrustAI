# Copy to .env (repo root). All integrations are optional; the app runs in demo mode without them.

# --- Core ---------------------------------------------------------------
JWT_SECRET=change-me-to-a-long-random-string
DEMO_MODE=true                      # false in production: disables one-click demo accounts
DOCTOR_INVITE_CODE=MEDTRUST-STAFF   # required for doctor/student self-registration
DATABASE_PATH=backend/data/medtrust.db
CORS_ORIGINS=http://localhost:5173,http://localhost:8000
HOSPITAL_NAME=MedTrust University Teaching Hospital

# --- Gemini (AI case sheet + multilingual summaries) --------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Google Meet REST + Calendar (optional external meeting link + transcript import)
# OAuth client + refresh token for a Workspace account. Scopes:
#   https://www.googleapis.com/auth/calendar.events
#   https://www.googleapis.com/auth/meetings.space.created
#   https://www.googleapis.com/auth/meetings.space.readonly
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary

# --- Firebase Authentication (optional Google sign-in) -------------------
FIREBASE_PROJECT_ID=
# Frontend build-time values (frontend/.env or exported before `npm run build`)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# --- WebRTC ICE (TURN strongly recommended across hospital networks) -----
STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=
